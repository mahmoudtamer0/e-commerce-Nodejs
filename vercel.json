{
    "version": 2,
    "builds": [
        {
            "src": "src/api/index.js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/api-docs/(.*)",
            "dest": "src/api-docs"
        },
        {
            "src": "/(.*)",
            "dest": "src/api/index.js"
        }
    ]
}